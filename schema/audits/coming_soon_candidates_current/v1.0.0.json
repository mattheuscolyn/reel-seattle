{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reelseattle.com/schema/audits/coming_soon_candidates_current/v1.0.0.json",
  "title": "Reel Seattle Coming Soon Candidates (analysis)",
  "description": "Full classified Coming Soon candidate set for analysis: user-visible cards plus hidden tmdb_only rows and high-confidence presentation-filtered AMC SKUs. Not shipped in dist/data.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "timezone",
    "window",
    "method",
    "sources",
    "stats",
    "entries"
  ],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "generated_at": { "type": "string", "format": "date-time" },
    "timezone": { "type": "string", "const": "America/Los_Angeles" },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start_date",
        "end_date",
        "days",
        "current_availability_cutoff",
        "current_availability_days"
      ],
      "properties": {
        "start_date": { "type": "string", "format": "date" },
        "end_date": { "type": "string", "format": "date" },
        "days": { "type": "integer", "minimum": 1 },
        "current_availability_cutoff": { "type": "string", "format": "date" },
        "current_availability_days": { "type": "integer", "minimum": 0 }
      }
    },
    "method": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "description"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "amc_coming_soon_catalog",
        "tmdb_us_theatrical",
        "reel_seattle_showtimes",
        "amc_theater_bookings"
      ],
      "properties": {
        "amc_coming_soon_catalog": {
          "type": "object",
          "additionalProperties": false,
          "required": ["available", "generated_at", "fetch_status", "movies"],
          "properties": {
            "available": { "type": "boolean" },
            "generated_at": { "type": ["string", "null"] },
            "fetch_status": { "type": ["string", "null"] },
            "movies": { "type": "integer", "minimum": 0 }
          }
        },
        "tmdb_us_theatrical": {
          "type": "object",
          "additionalProperties": false,
          "required": ["available", "generated_at", "fetch_status", "candidates"],
          "properties": {
            "available": { "type": "boolean" },
            "generated_at": { "type": ["string", "null"] },
            "fetch_status": { "type": ["string", "null"] },
            "candidates": { "type": "integer", "minimum": 0 }
          }
        },
        "reel_seattle_showtimes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["available", "generated_at", "published_window_end"],
          "properties": {
            "available": { "type": "boolean" },
            "generated_at": { "type": ["string", "null"] },
            "published_window_end": { "type": ["string", "null"], "format": "date" }
          }
        },
        "amc_theater_bookings": {
          "type": "object",
          "additionalProperties": false,
          "required": ["available", "scrape_log"],
          "properties": {
            "available": { "type": "boolean" },
            "scrape_log": { "type": ["string", "null"] }
          }
        }
      }
    },
    "stats": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entry_count",
        "user_visible_count",
        "hidden_count",
        "classification_counts",
        "evidence_counts",
        "horizon_counts",
        "earliest_expected_release_date",
        "latest_expected_release_date",
        "entries_with_confirmed_film_id",
        "entries_without_confirmed_film_id",
        "entries_with_tmdb_id",
        "ambiguous_identity_count",
        "duplicate_film_id_count",
        "duplicate_join_key_count",
        "merged_candidate_count",
        "collapsed_event_variants",
        "excluded_counts",
        "presentation_kind_counts",
        "presentation_source_counts",
        "entries_with_poster"
      ],
      "properties": {
        "entry_count": { "type": "integer", "minimum": 0 },
        "user_visible_count": { "type": "integer", "minimum": 0 },
        "hidden_count": { "type": "integer", "minimum": 0 },
        "classification_counts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["confirmed_local", "amc_announced", "tmdb_only"],
          "properties": {
            "confirmed_local": { "type": "integer", "minimum": 0 },
            "amc_announced": { "type": "integer", "minimum": 0 },
            "tmdb_only": { "type": "integer", "minimum": 0 }
          }
        },
        "evidence_counts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "amc_coming_soon_catalog",
            "amc_theater_booking",
            "tmdb_us_theatrical",
            "reel_seattle_scheduled"
          ],
          "properties": {
            "amc_coming_soon_catalog": { "type": "integer", "minimum": 0 },
            "amc_theater_booking": { "type": "integer", "minimum": 0 },
            "tmdb_us_theatrical": { "type": "integer", "minimum": 0 },
            "reel_seattle_scheduled": { "type": "integer", "minimum": 0 }
          }
        },
        "horizon_counts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["30_days", "60_days", "90_days"],
          "properties": {
            "30_days": { "type": "integer", "minimum": 0 },
            "60_days": { "type": "integer", "minimum": 0 },
            "90_days": { "type": "integer", "minimum": 0 }
          }
        },
        "earliest_expected_release_date": {
          "type": ["string", "null"],
          "format": "date"
        },
        "latest_expected_release_date": {
          "type": ["string", "null"],
          "format": "date"
        },
        "entries_with_confirmed_film_id": { "type": "integer", "minimum": 0 },
        "entries_without_confirmed_film_id": { "type": "integer", "minimum": 0 },
        "entries_with_tmdb_id": { "type": "integer", "minimum": 0 },
        "ambiguous_identity_count": { "type": "integer", "minimum": 0 },
        "duplicate_film_id_count": { "type": "integer", "minimum": 0 },
        "duplicate_join_key_count": { "type": "integer", "minimum": 0 },
        "merged_candidate_count": { "type": "integer", "minimum": 0 },
        "collapsed_event_variants": { "type": "integer", "minimum": 0 },
        "presentation_kind_counts": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "presentation_source_counts": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "entries_with_poster": { "type": "integer", "minimum": 0 },
        "excluded_counts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "currently_available",
            "expected_release_date_outside_window",
            "no_expected_release_date",
            "insufficient_evidence",
            "presentation_filter"
          ],
          "properties": {
            "currently_available": { "type": "integer", "minimum": 0 },
            "expected_release_date_outside_window": { "type": "integer", "minimum": 0 },
            "no_expected_release_date": { "type": "integer", "minimum": 0 },
            "insufficient_evidence": { "type": "integer", "minimum": 0 },
            "presentation_filter": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "entries": {
      "type": "array",
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "film_id",
        "title",
        "join_key",
        "parent_film_keys",
        "showtime_film_keys",
        "tmdb_id",
        "amc_movie_id",
        "amc_movie_ids",
        "expected_release_date",
        "expected_release_date_source",
        "amc_catalog_release_date",
        "tmdb_us_release_date",
        "first_local_screening_date",
        "first_local_screening_source",
        "local_status",
        "local_theater_ids",
        "local_theaters",
        "local_theater_count",
        "local_showtime_count",
        "evidence",
        "classification",
        "user_visible",
        "exclusion_reason",
        "presentation",
        "identity",
        "source_metadata"
      ],
      "properties": {
        "film_id": { "type": ["string", "null"], "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "join_key": { "type": "string", "minLength": 1 },
        "parent_film_keys": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "showtime_film_keys": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "tmdb_id": { "type": ["integer", "null"], "minimum": 1 },
        "amc_movie_id": { "type": ["string", "null"], "minLength": 1 },
        "amc_movie_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "expected_release_date": { "type": "string", "format": "date" },
        "expected_release_date_source": {
          "type": "string",
          "enum": [
            "reel_seattle_first_local_screening",
            "amc_catalog_release_date",
            "tmdb_us_release_date"
          ]
        },
        "amc_catalog_release_date": { "type": ["string", "null"], "format": "date" },
        "tmdb_us_release_date": { "type": ["string", "null"], "format": "date" },
        "first_local_screening_date": { "type": ["string", "null"], "format": "date" },
        "first_local_screening_source": {
          "type": ["string", "null"],
          "enum": ["reel_seattle_showtimes", "amc_theater_booking", null]
        },
        "local_status": {
          "type": "string",
          "enum": ["scheduled", "not_announced"]
        },
        "local_theater_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "local_theaters": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["theater_id", "name"],
            "properties": {
              "theater_id": { "type": "string", "minLength": 1 },
              "name": { "type": "string", "minLength": 1 }
            }
          }
        },
        "local_theater_count": { "type": "integer", "minimum": 0 },
        "local_showtime_count": { "type": "integer", "minimum": 0 },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "amc_coming_soon_catalog",
            "amc_theater_booking",
            "tmdb_us_theatrical",
            "reel_seattle_scheduled"
          ],
          "properties": {
            "amc_coming_soon_catalog": { "type": "boolean" },
            "amc_theater_booking": { "type": "boolean" },
            "tmdb_us_theatrical": { "type": "boolean" },
            "reel_seattle_scheduled": { "type": "boolean" }
          }
        },
        "classification": {
          "type": "string",
          "enum": ["confirmed_local", "amc_announced", "tmdb_only"]
        },
        "user_visible": { "type": "boolean" },
        "exclusion_reason": {
          "type": ["string", "null"],
          "enum": [
            "private_theatre_rental",
            "untitled_distributor_placeholder",
            "operational_or_test_row",
            null
          ]
        },
        "presentation": { "$ref": "#/$defs/presentation" },
        "identity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "method",
            "film_id_confirmed",
            "tmdb_id_inferred",
            "ambiguous",
            "variant_titles",
            "contributing_sources"
          ],
          "properties": {
            "method": {
              "type": "string",
              "enum": ["film_id", "amc_movie_id", "tmdb_id", "join_key"]
            },
            "film_id_confirmed": { "type": "boolean" },
            "tmdb_id_inferred": { "type": "boolean" },
            "ambiguous": { "type": "boolean" },
            "variant_titles": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            },
            "contributing_sources": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": ["amc_catalog", "amc_booking", "reel_seattle", "tmdb"]
              }
            }
          }
        },
        "source_metadata": {
          "type": "object",
          "additionalProperties": false,
          "required": ["amc", "tmdb"],
          "properties": {
            "amc": {
              "oneOf": [
                { "type": "null" },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["amc_movie_id"],
                  "properties": {
                    "amc_movie_id": { "type": "string", "minLength": 1 },
                    "source_title": { "type": ["string", "null"] },
                    "has_scheduled_showtimes": { "type": ["boolean", "null"] },
                    "online_ticket_availability_date_utc": { "type": ["string", "null"] },
                    "earliest_showing_utc": { "type": ["string", "null"] },
                    "runtime_min": { "type": ["integer", "null"] },
                    "mpaa_rating": { "type": ["string", "null"] },
                    "genre": { "type": ["string", "null"] },
                    "slug": { "type": ["string", "null"] },
                    "synopsis": { "type": ["string", "null"] },
                    "poster_url": { "type": ["string", "null"] },
                    "hero_desktop_url": { "type": ["string", "null"] },
                    "hero_mobile_url": { "type": ["string", "null"] },
                    "presentation_category": { "type": ["string", "null"] },
                    "is_special_presentation": { "type": ["boolean", "null"] }
                  }
                }
              ]
            },
            "tmdb": {
              "oneOf": [
                { "type": "null" },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["tmdb_id"],
                  "properties": {
                    "tmdb_id": { "type": "integer", "minimum": 1 },
                    "original_title": { "type": ["string", "null"] },
                    "original_language": { "type": ["string", "null"] },
                    "popularity": { "type": ["number", "null"], "minimum": 0 },
                    "vote_count": { "type": ["integer", "null"], "minimum": 0 },
                    "poster_path": { "type": ["string", "null"] },
                    "backdrop_path": { "type": ["string", "null"] },
                    "overview": { "type": ["string", "null"] },
                    "has_poster": { "type": ["boolean", "null"] },
                    "has_overview": { "type": ["boolean", "null"] },
                    "quality_flags": {
                      "type": "array",
                      "items": { "type": "string" }
                    }
                  }
                }
              ]
            }
          }
        }
      }
    },
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "source",
        "poster_url",
        "poster_path",
        "backdrop_url",
        "backdrop_path",
        "overview",
        "runtime_minutes",
        "rating",
        "release_year"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "film",
            "rerelease",
            "event",
            "mystery_screening",
            "placeholder",
            "rental",
            "other"
          ]
        },
        "source": {
          "type": "string",
          "enum": [
            "confirmed_enrichment",
            "amc_catalog",
            "inferred_tmdb",
            "fallback"
          ]
        },
        "poster_url": { "type": ["string", "null"] },
        "poster_path": { "type": ["string", "null"] },
        "backdrop_url": { "type": ["string", "null"] },
        "backdrop_path": { "type": ["string", "null"] },
        "overview": { "type": ["string", "null"] },
        "runtime_minutes": { "type": ["integer", "null"], "minimum": 1 },
        "rating": { "type": ["string", "null"] },
        "release_year": { "type": ["integer", "null"], "minimum": 1888 }
      }
    }
  }
}
