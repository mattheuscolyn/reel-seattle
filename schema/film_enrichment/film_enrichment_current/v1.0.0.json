{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reelseattle.local/schema/film_enrichment/film_enrichment_current/v1.0.0.json",
  "title": "Film enrichment current (TMDB minimal)",
  "description": "Public TMDB enrichment artifact for confirmed tmdb: identities (T-ENR-01B). Separate from showtimes_current.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "generated_at",
    "provider",
    "language",
    "image_config",
    "films"
  ],
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "generated_at": { "type": "string", "minLength": 1 },
    "provider": { "type": "string", "const": "tmdb" },
    "language": { "type": "string", "minLength": 1 },
    "image_config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["secure_base_url", "poster_size", "backdrop_size"],
      "properties": {
        "secure_base_url": { "type": "string", "minLength": 1 },
        "poster_size": { "type": "string", "minLength": 1 },
        "backdrop_size": { "type": "string", "minLength": 1 }
      }
    },
    "films": {
      "type": "array",
      "items": { "$ref": "#/$defs/film" }
    }
  },
  "$defs": {
    "genre": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "id": { "type": ["integer", "null"] },
        "name": { "type": "string", "minLength": 1 }
      }
    },
    "director": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "tmdb_person_id": { "type": ["integer", "null"], "minimum": 1 },
        "name": { "type": "string", "minLength": 1 }
      }
    },
    "cast_member": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "tmdb_person_id": { "type": ["integer", "null"], "minimum": 1 },
        "name": { "type": "string", "minLength": 1 },
        "character": { "type": ["string", "null"] },
        "order": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "image_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": { "type": "string", "pattern": "^/" },
        "url": { "type": ["string", "null"], "minLength": 1 }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": true,
      "required": ["provider", "fetched_at"],
      "properties": {
        "provider": { "type": "string", "const": "tmdb" },
        "fetched_at": { "type": "string", "minLength": 1 },
        "language": { "type": "string", "minLength": 1 }
      }
    },
    "film": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "film_id",
        "tmdb_id",
        "genres",
        "directors",
        "provenance"
      ],
      "properties": {
        "film_id": {
          "type": "string",
          "pattern": "^tmdb:[1-9][0-9]*$"
        },
        "tmdb_id": { "type": "integer", "minimum": 1 },
        "imdb_id": {
          "type": ["string", "null"],
          "pattern": "^tt[0-9]{7,8}$"
        },
        "original_title": { "type": ["string", "null"] },
        "display_title": { "type": ["string", "null"] },
        "original_language": { "type": ["string", "null"] },
        "release_date": {
          "type": ["string", "null"],
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "release_year": { "type": ["integer", "null"], "minimum": 1888 },
        "runtime_minutes": { "type": ["integer", "null"], "minimum": 1 },
        "us_certification": { "type": ["string", "null"], "minLength": 1, "maxLength": 16 },
        "overview": { "type": ["string", "null"], "maxLength": 4000 },
        "genres": {
          "type": "array",
          "items": { "$ref": "#/$defs/genre" }
        },
        "directors": {
          "type": "array",
          "items": { "$ref": "#/$defs/director" }
        },
        "top_cast": {
          "type": "array",
          "maxItems": 5,
          "items": { "$ref": "#/$defs/cast_member" }
        },
        "poster": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/image_ref" }
          ]
        },
        "backdrop": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/image_ref" }
          ]
        },
        "provenance": { "$ref": "#/$defs/provenance" },
        "field_provenance": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "enum": [
              "tmdb",
              "theater_source",
              "manual_override",
              "derived",
              "unavailable"
            ]
          }
        }
      }
    }
  }
}
