{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reelseattle.com/schema/source_catalog/amc_movie_products/v1.0.0.json",
  "title": "AMC Movie Product Catalog",
  "description": "Durable internal AMC movie-product catalog. Generated source evidence — not public, not canonical.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "source",
    "stats",
    "products"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "generated_at": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "const": "amc"
    },
    "stats": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "products",
        "active_products",
        "inactive_products",
        "with_release_id",
        "without_release_id",
        "refresh_pending",
        "refresh_success",
        "refresh_stale",
        "refresh_failed",
        "refresh_invalid",
        "special_presentations"
      ],
      "properties": {
        "products": { "type": "integer", "minimum": 0 },
        "active_products": { "type": "integer", "minimum": 0 },
        "inactive_products": { "type": "integer", "minimum": 0 },
        "with_release_id": { "type": "integer", "minimum": 0 },
        "without_release_id": { "type": "integer", "minimum": 0 },
        "refresh_pending": { "type": "integer", "minimum": 0 },
        "refresh_success": { "type": "integer", "minimum": 0 },
        "refresh_stale": { "type": "integer", "minimum": 0 },
        "refresh_failed": { "type": "integer", "minimum": 0 },
        "refresh_invalid": { "type": "integer", "minimum": 0 },
        "special_presentations": { "type": "integer", "minimum": 0 }
      }
    },
    "products": {
      "type": "array",
      "items": { "$ref": "#/$defs/product" }
    }
  },
  "$defs": {
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "source_film_id",
        "source_release_id",
        "source_title",
        "sortable_title",
        "runtime_min",
        "release_date_utc",
        "earliest_showing_utc",
        "online_ticket_availability_date_utc",
        "has_scheduled_showtimes",
        "genre",
        "mpaa_rating",
        "starring_actors_raw",
        "directors_raw",
        "synopsis",
        "distributor_id",
        "distributor_code",
        "preferred_media_type",
        "available_for_a_list",
        "slug",
        "website_url",
        "showtimes_url",
        "attribute_codes",
        "media",
        "presentation",
        "lifecycle",
        "provenance"
      ],
      "properties": {
        "source": { "type": "string", "const": "amc" },
        "source_film_id": { "type": "string", "minLength": 1 },
        "source_release_id": { "type": ["string", "null"], "minLength": 1 },
        "source_title": { "type": ["string", "null"] },
        "sortable_title": { "type": ["string", "null"] },
        "runtime_min": { "type": ["integer", "null"] },
        "release_date_utc": { "type": ["string", "null"] },
        "earliest_showing_utc": { "type": ["string", "null"] },
        "online_ticket_availability_date_utc": { "type": ["string", "null"] },
        "has_scheduled_showtimes": { "type": ["boolean", "null"] },
        "genre": { "type": ["string", "null"] },
        "mpaa_rating": { "type": ["string", "null"] },
        "starring_actors_raw": { "type": ["string", "null"] },
        "directors_raw": { "type": ["string", "null"] },
        "synopsis": { "type": ["string", "null"] },
        "distributor_id": { "type": ["string", "null"] },
        "distributor_code": { "type": ["string", "null"] },
        "preferred_media_type": { "type": ["string", "null"] },
        "available_for_a_list": { "type": ["boolean", "null"] },
        "slug": { "type": ["string", "null"] },
        "website_url": { "type": ["string", "null"] },
        "showtimes_url": { "type": ["string", "null"] },
        "attribute_codes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "media": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "poster_url",
            "hero_desktop_url",
            "hero_mobile_url",
            "trailer_hd_url",
            "trailer_mp4_url"
          ],
          "properties": {
            "poster_url": { "type": ["string", "null"] },
            "hero_desktop_url": { "type": ["string", "null"] },
            "hero_mobile_url": { "type": ["string", "null"] },
            "trailer_hd_url": { "type": ["string", "null"] },
            "trailer_mp4_url": { "type": ["string", "null"] }
          }
        },
        "presentation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "category",
            "is_special_presentation",
            "classifier_version"
          ],
          "properties": {
            "category": {
              "type": "string",
              "enum": [
                "standard",
                "q_and_a",
                "special_introduction",
                "sensory_friendly",
                "open_caption",
                "dubbed_or_subtitled",
                "anniversary_or_rerelease",
                "mystery_screening",
                "concert_or_event",
                "marathon_or_multi_feature",
                "other_special",
                "unknown"
              ]
            },
            "is_special_presentation": { "type": "boolean" },
            "classifier_version": { "type": "string", "minLength": 1 }
          }
        },
        "lifecycle": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "first_seen_at",
            "last_seen_at",
            "last_refreshed_at",
            "last_successful_refresh_at",
            "inactive_since",
            "refresh_status"
          ],
          "properties": {
            "first_seen_at": { "type": "string", "minLength": 1 },
            "last_seen_at": { "type": "string", "minLength": 1 },
            "last_refreshed_at": { "type": ["string", "null"] },
            "last_successful_refresh_at": { "type": ["string", "null"] },
            "inactive_since": { "type": ["string", "null"] },
            "refresh_status": {
              "type": "string",
              "enum": ["pending", "success", "stale", "failed", "invalid"]
            }
          }
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "metadata_source",
            "observation_source",
            "last_input_kind",
            "derived_fields"
          ],
          "properties": {
            "metadata_source": {
              "type": "string",
              "const": "amc_movies_api"
            },
            "observation_source": {
              "type": "string",
              "const": "amc_showtimes"
            },
            "last_input_kind": { "type": "string", "minLength": 1 },
            "derived_fields": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
