{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reelseattle.com/schema/opening_this_week_current/v1.1.0.json",
  "title": "Reel Seattle Opening This Week Current",
  "description": "Citywide Seattle openings for the current Monday–Sunday Pacific week, derived from historical earliest scheduled show dates. Review-only until UI is wired. V1.1 adds repertory classification and engagement metrics without changing membership.",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "timezone",
    "week",
    "method",
    "stats",
    "entries",
    "low_confidence_candidates"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "timezone": {
      "type": "string",
      "const": "America/Los_Angeles"
    },
    "week": {
      "type": "object",
      "required": ["start_date", "end_date"],
      "additionalProperties": false,
      "properties": {
        "start_date": { "type": "string", "format": "date" },
        "end_date": { "type": "string", "format": "date" }
      }
    },
    "method": {
      "type": "object",
      "required": ["name", "version", "description"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "stats": {
      "type": "object",
      "required": [
        "entry_count",
        "low_confidence_count",
        "override_applied_count",
        "earliest_opening_date",
        "latest_opening_date",
        "opening_type_counts"
      ],
      "additionalProperties": false,
      "properties": {
        "entry_count": { "type": "integer", "minimum": 0 },
        "low_confidence_count": { "type": "integer", "minimum": 0 },
        "override_applied_count": { "type": "integer", "minimum": 0 },
        "earliest_opening_date": {
          "type": ["string", "null"],
          "format": "date"
        },
        "latest_opening_date": {
          "type": ["string", "null"],
          "format": "date"
        },
        "opening_type_counts": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "entries": {
      "type": "array",
      "items": { "$ref": "#/$defs/entry" }
    },
    "low_confidence_candidates": {
      "type": "array",
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "required": [
        "showtime_film_key",
        "parent_film_key",
        "film_id",
        "film_title",
        "opening_date",
        "theaters_on_opening_date",
        "theater_count_on_opening_date",
        "visible_showtime_count",
        "engagement_days",
        "historical_screening_count",
        "opening_type",
        "confidence",
        "evidence",
        "override"
      ],
      "additionalProperties": false,
      "properties": {
        "showtime_film_key": { "type": "string", "minLength": 1 },
        "parent_film_key": { "type": "string", "minLength": 1 },
        "film_id": { "type": ["string", "null"], "minLength": 1 },
        "film_title": { "type": "string", "minLength": 1 },
        "opening_date": { "type": "string", "format": "date" },
        "theaters_on_opening_date": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "theater_count_on_opening_date": { "type": "integer", "minimum": 0 },
        "visible_showtime_count": { "type": "integer", "minimum": 0 },
        "engagement_days": { "type": "integer", "minimum": 0 },
        "historical_screening_count": { "type": "integer", "minimum": 0 },
        "opening_type": {
          "type": "string",
          "enum": ["theatrical", "repertory", "limited", "event", "unknown"]
        },
        "confidence": {
          "type": "string",
          "enum": ["high", "low"]
        },
        "evidence": {
          "type": "object",
          "required": [
            "identity_method",
            "variant_showtime_film_keys",
            "distinct_scheduled_dates",
            "bootstrap_theater_ids",
            "mature_theater_ids",
            "sources"
          ],
          "additionalProperties": false,
          "properties": {
            "identity_method": {
              "type": "string",
              "enum": ["film_id", "parent_film_key", "showtime_film_key"]
            },
            "variant_showtime_film_keys": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            },
            "distinct_scheduled_dates": { "type": "integer", "minimum": 0 },
            "bootstrap_theater_ids": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            },
            "mature_theater_ids": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            },
            "sources": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            }
          }
        },
        "override": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["id", "action", "reason"],
              "additionalProperties": false,
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "action": { "type": "string", "enum": ["include", "exclude"] },
                "reason": { "type": "string", "minLength": 1 },
                "forced_opening_date": {
                  "type": ["string", "null"],
                  "format": "date"
                }
              }
            }
          ]
        }
      }
    }
  }
}
